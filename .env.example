# Copy to .env and choose a local password; never commit the real .env.
POSTGRES_PASSWORD=replace_with_a_local_password
# Export DATABASE_URL in both API and worker shells, URL-encoding the password.
# DATABASE_URL=postgresql+psycopg://knowlm:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/knowlm
KNOWLM_AUTO_SCHEMA=0

# Optional external generation. Disabled unless explicitly enabled by the operator.
# Python does not auto-load this file: export values in the API process environment.
KNOWLM_LLM_ENABLED=0
KNOWLM_LLM_BASE_URL=https://api.openai.com/v1
# KNOWLM_LLM_API_KEY: set through your deployment secret manager; do not commit it.
# KNOWLM_LLM_MODEL: set to a model available with your provider/account.

# Use 0 in restricted/offline environments (as in the Arena preview).
# Set 1 in BOTH API and worker only when YouTube network access is permitted.
# Configuration is not a successful connectivity check; see docs/YOUTUBE.md.
KNOWLM_YOUTUBE_FETCH_ENABLED=0

# Persistent per-minute budgets and per-owner/notebook resource quotas.
# Positive integers only. See docs/LIMITS.md for proxy trust and deployment limits.
KNOWLM_AUTH_PER_MINUTE=60
KNOWLM_MUTATIONS_PER_MINUTE=120
KNOWLM_ASK_PER_MINUTE=30
KNOWLM_INGESTION_PER_MINUTE=10
KNOWLM_ACCOUNT_DELETE_PER_MINUTE=5
KNOWLM_MAX_NOTEBOOKS=20
KNOWLM_MAX_SOURCES_PER_NOTEBOOK=100
KNOWLM_MAX_ACTIVE_JOBS_PER_NOTEBOOK=4

# Optional external semantic retrieval: independently disabled by default.
# Only requests with semantic_consent=true transmit selected chunk texts.
# Request-scoped vectors; no persistent vector index in this increment.
KNOWLM_EMBEDDINGS_ENABLED=0
KNOWLM_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# KNOWLM_EMBEDDINGS_API_KEY: deployment secret manager only.
# KNOWLM_EMBEDDINGS_MODEL: multilingual embedding model available to your account.
