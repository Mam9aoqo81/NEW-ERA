{
  "name": "knowlm-web",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src vite.config.ts playwright.config.ts e2e",
    "format:check": "prettier --check src vite.config.ts playwright.config.ts e2e"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sparticuz/chromium": "^158.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "prettier": "^3.10.1",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
